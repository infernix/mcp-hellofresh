{
  "name": "@striderlabs/mcp-hellofresh",
  "version": "1.0.0",
  "description": "Model Context Protocol connector for HelloFresh meal kit delivery",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-hellofresh": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "test": "npm run build && node --test test/browser.test.js test/index.test.js",
    "test:live": "npm run build && node --test test/live.test.js",
    "verify": "npm run lint && npm run test",
    "verify:live": "npm run lint && npm run test && npm run test:live",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "pack": "npm pack",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hellofresh",
    "meal-kit",
    "claude"
  ],
  "author": "Strider Labs",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright": "^1.40.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^8.57.1",
    "globals": "^17.6.0",
    "typescript": "^5.3.2"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
